[Unit]
Description=InkMuse HTTPS proxy
After=network-online.target draw-guess.service
Wants=network-online.target

[Service]
Type=notify
User=draw-guess-proxy
Group=draw-guess-proxy
EnvironmentFile=/etc/draw-guess-proxy.env
Environment=XDG_DATA_HOME=/var/lib/draw-guess-proxy
Environment=XDG_CONFIG_HOME=/var/lib/draw-guess-proxy
ExecStart=/opt/draw-guess/bin/caddy run --config /etc/draw-guess.Caddyfile --adapter caddyfile
ExecReload=/opt/draw-guess/bin/caddy reload --config /etc/draw-guess.Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=3
StateDirectory=draw-guess-proxy
StateDirectoryMode=0700
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/draw-guess-proxy

[Install]
WantedBy=multi-user.target
